{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "gray",
        "model": {
          "type": "minecraft:model",
          "model": "bloomcraft:item/boss_totem_gray"
        }
      },
      {
        "when": "green",
        "model": {
          "type": "minecraft:model",
          "model": "bloomcraft:item/boss_totem_green"
        }
      },
      {
        "when": "red",
        "model": {
          "type": "minecraft:model",
          "model": "bloomcraft:item/boss_totem_red"
        }
      },
      {
        "when": "purple",
        "model": {
          "type": "minecraft:model",
          "model": "bloomcraft:item/boss_totem_purple"
        }
      },
      {
        "when": "gold",
        "model": {
          "type": "minecraft:model",
          "model": "bloomcraft:item/boss_totem_gold"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "bloomcraft:item/boss_totem_green"
    }
  }
}
